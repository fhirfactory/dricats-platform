<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.fhirfactory.dricats</groupId>
        <artifactId>dricats-middleware-oam</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>dricats-middleware-oam-central</artifactId>
    <name>DRICaTS :: Middleware :: OAM Central</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>net.fhirfactory.dricats</groupId>
            <artifactId>dricats-middleware-jgroups</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.dricats</groupId>
            <artifactId>dricats-model-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Infinispan for distributed cache -->
        <dependency>
            <groupId>org.infinispan</groupId>
            <artifactId>infinispan-core</artifactId>
            <version>${version-org.infinispan}</version>
        </dependency>
        <!-- OAM common repository interfaces/impls -->
        <dependency>
            <groupId>net.fhirfactory.dricats</groupId>
            <artifactId>dricats-middleware-datagrid-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Access ApplicationComponentCacheClient from satellite module -->
        <dependency>
            <groupId>net.fhirfactory.dricats</groupId>
            <artifactId>dricats-middleware-datagrid-satellite</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CDI API provided by runtime -->
        <dependency>
            <groupId>javax.enterprise</groupId>
            <artifactId>cdi-api</artifactId>
            <version>2.0.SP1</version>
            <scope>provided</scope>
        </dependency>
        <!-- javax.annotation API (provided by container) -->
        <dependency>
            <groupId>org.jboss.spec.javax.annotation</groupId>
            <artifactId>jboss-annotations-api_1.3_spec</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- H2 database for metrics persistence -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${version-com.h2database-h2}</version>
        </dependency>
        <!-- Jackson for serialising distribution map to JSON strings in JDBC layer -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${version-com.fasterxml.jackson.core-jackson-databind}</version>
        </dependency>
        <!-- Apache Camel for REST exposure -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-cdi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-undertow</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-jackson</artifactId>
        </dependency>
    </dependencies>
</project>
